      "picture": {
        "kind": "card"
      },
      "durationMs": 29900,
      "burnIns": [
        {
          "kind": "flow",
          "params": {
            "kicker": "FLOW · A WEEK IN PARTS, VERSION 5",
            "title": "Too long for one video: a series, split at its chapters",
            "steps": [
              {
                "badge": "main",
                "label": "Measure by words",
                "command": "estimatedMs",
                "note": "Before anything is said: each scene at its reading time."
              },
              {
                "badge": "main",
                "label": "Break at a chapter",
                "command": "aim 8 min, most 10",
                "note": "Whole sections while a part stays under the aim."
              },
              {
                "badge": "main",
                "label": "A section too long",
                "command": "split between items",
                "note": "Each part filled to the aim; past 10 only for a single item that is."
              },
              {
                "badge": "main",
                "label": "Each part opens alike",
                "command": "locked intro, brand",
                "note": "The intro says part n of m; a section carried over says continued."
              }
            ]
          }
        }
      ]
    },
