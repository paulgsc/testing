            "kicker": "CHEAT SHEET · THE WORKER'S CAPS",
            "title": "What one render may take",
            "rows": [
              {
                "badge": "main",
                "task": "Longest video",
                "command": "15 minutes",
                "note": "Refused by its words, before anything is said."
              },
              {
                "badge": "main",
                "task": "Largest video",
                "command": "500 MB"
              },
              {
                "badge": "main",
                "task": "One video's step cache",
                "command": "2048 MB",
                "note": "Past it a step runs uncached, with a warning, never a failure."
              },
              {
                "badge": "main",
                "task": "All work waiting",
                "command": "4096 MB",
                "note": "Past it, the oldest other episode's work goes; its retry starts over."
              }
            ]
          }
        }
      ]
    },
