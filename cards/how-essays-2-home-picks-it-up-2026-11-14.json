      },
      "durationMs": 26600,
      "burnIns": [
        {
          "kind": "cheat-sheet",
          "params": {
            "kicker": "CHEAT SHEET · YIELDS AND FAILURES",
            "title": "Giving way is never failing",
            "rows": [
              {
                "badge": "main",
                "task": "A pause or a stop",
                "command": "no failed.log",
                "note": "The job resumes under the same id; every finished step is a cache hit."
              },
              {
                "badge": "main",
                "task": "Fails soon after a pause",
                "command": "run again",
                "note": "Within 5 minutes of it, at most 3 times a job."
              },
              {
                "badge": "main",
                "task": "A real failure",
                "command": "<key>.failed.log",
                "note": "CallRenderFailed reaches you; tried again an hour later."
              },
              {
                "badge": "main",
                "task": "3 restarts not asked for",
                "command": "taken as failed",
                "note": "So a render that kills its own container isn't resumed for good."
              }
            ]
          }
        }
      ]
    },
