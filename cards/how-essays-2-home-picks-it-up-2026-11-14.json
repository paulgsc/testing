        {
          "kind": "flow",
          "params": {
            "kicker": "FLOW · TESTING TO HOME",
            "title": "file_host's call_weeks worker keeps every week",
            "steps": [
              {
                "badge": "main",
                "label": "Read the index",
                "command": "every hour",
                "note": "call/index.json on testing's main, public, no token."
              },
              {
                "badge": "main",
                "label": "Fetch what's missing",
                "command": "call/<from>.json",
                "note": "Only weeks home doesn't hold, at most 1 MiB each, schema and days checked."
              },
              {
                "badge": "main",
                "label": "Keep it once",
                "command": "the call_week table",
                "note": "Append-only, as first served. A week home holds is never fetched again."
              },
              {
                "badge": "main",
                "label": "Hand it to the worker",
                "command": "${STORAGE}/call-weeks/",
                "note": "<from>.json byte for byte, mounted read-only into render."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C2",
      "picture": {
        "kind": "card"
      },
      "durationMs": 28400,
      "burnIns": [
        {
          "kind": "terminal",
          "params": {
            "kicker": "TERMINAL · WHY A POLL",
            "title": "GitHub tells home nothing, and home only asks",
            "bar": "apps/servers/file_host/src/call_weeks.rs",
            "lines": [
              {
                "keyword": "INTERVAL: 3600 s",
                "comment": "  # a week arrives once a week"
              },
              {
                "comment": "# an idle pass is that one request"
              },
              {
                "comment": "# a failed pass: tried again in 10 min, then 20, up to an hour"
              },
              {
                "comment": "# failures are counted by kind; no URL or week's words reach a log"
              },
              {
                "comment": "# the mailbox's call index lists each week home holds, with its SHA-256",
                "badge": "main"
              },
              {
                "comment": "# the routine lets a week leave testing only once that index lists it"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C3",
      "picture": {
        "kind": "card"
      },
      "durationMs": 23600,
      "burnIns": [
        {
          "kind": "cheat-sheet",
          "params": {
            "kicker": "CHEAT SHEET · TWO SERVICES",
            "title": "infra/compose/call-render.yml: one network that reaches nothing else",
            "rows": [
              {
                "badge": "main",
                "task": "kokoro",
                "command": "the speaker",
                "note": "Kokoro v1.0. 3 GiB memory cap, 2 CPUs."
              },
              {
                "badge": "main",
                "task": "render",
                "command": "the worker",
                "note": "Runs render-calls.sh, mounted from server. 4 GiB cap, 2 CPUs."
              },
              {
                "badge": "main",
                "task": "render's image",
                "command": "built by some-ui's CI",
                "note": "Recorders, stage, Chromium, ffmpeg and fonts at one commit, pinned by digest."
              },
              {
                "badge": "main",
                "task": "Both are batch",
                "command": "cpu_shares: 256",
                "note": "A quarter of the default CPU weight, and the first the kernel kills."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C4",
      "picture": {
        "kind": "card"
      },
      "durationMs": 26600,
      "burnIns": [
        {
          "kind": "terminal",
          "params": {
            "kicker": "TERMINAL · ONE WORKER, SIX JOBS",
            "title": "The render worker makes one episode at a time",
            "bar": "infra/render/render-calls.sh",
            "lines": [
              {
                "keyword": "call  playoff-delta  preview  rust-essay  clip-walk  cards-essay",
                "badge": "main"
              },
              {
                "comment": "# one episode at a time: the call's first, each job's oldest first"
              },
              {
                "comment": "# it looks for work every minute; looking never starts a render"
              },
              {
                "comment": "# a week in parts is one job a part: <from>, then <from>-p<k>"
              },
              {
                "comment": "# a failed episode is tried again an hour later, not every minute"
              },
              {
                "comment": "# a finished folder is moved into place whole"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C5",
      "picture": {
        "kind": "card"
      },
      "durationMs": 26600,
      "burnIns": [
        {
          "kind": "flow",
          "params": {
            "kicker": "FLOW · THE LANE",
            "title": "No clock starts a render; room does",
            "steps": [
              {
                "badge": "main",
                "label": "Decide every 5 s",
                "command": "file_host's lane",
                "note": "From free memory, memory pressure, and whether interactive work waits."
              },
              {
                "badge": "main",
                "label": "run",
                "command": "room for the peak",
                "note": "Nothing interactive waiting, and the job's peak fits above a 2 GiB floor for 30 s."
              },
              {
                "badge": "main",
                "label": "pause",
                "command": "SIGSTOP",
                "note": "A voice note being heard or a Rust Rounds program recorded: the recorder freezes."
              },
              {
                "badge": "main",
                "label": "stop",
                "command": "killed, work kept",
                "note": "Memory short or pressure past 10%: it waits for room, its step cache intact."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C6",
      "picture": {
        "kind": "card"
      },
      "durationMs": 22400,
      "burnIns": [
        {
          "kind": "terminal",
          "params": {
            "kicker": "TERMINAL · HOME'S POLICY",
            "title": "The lane's numbers",
            "bar": "docs/home-compute.md, Home's policy",
            "lines": [
              {
                "keyword": "floor            2 GiB",
                "comment": "  # room kept for interactive work",
                "badge": "main"
              },
              {
                "keyword": "declared peak    5.84 GiB",
                "comment": "  # until a render is measured"
              },
              {
                "keyword": "free to start    8.09 GiB",
                "comment": "  # floor plus peak, to start"
              },
              {
                "keyword": "pressure limit   10%",
                "comment": "  # of some avg10"
              },
              {
                "keyword": "hold-down        30 s",
                "comment": "  # room has to hold this long"
              },
              {
                "keyword": "stuck after      3 stops",
                "comment": "  # in a row: LaneStuck tells you"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "C7",
      "picture": {
        "kind": "card"
      },
