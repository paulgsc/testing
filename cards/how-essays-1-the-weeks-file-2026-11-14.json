        {
          "kind": "flow",
          "params": {
            "kicker": "FLOW · WHO MAKES A CALL",
            "title": "Four hands: a session writes, code checks, home makes, you watch",
            "steps": [
              {
                "badge": "main",
                "label": "A scheduled session",
                "command": "CALL-ROUTINE.md",
                "note": "Writes the week as call/<from>.json in paulgsc/testing. Its part ends there."
              },
              {
                "badge": "main",
                "label": "Code checks it",
                "command": "render call-check",
                "note": "Refuses a week the template can't draw, before it merges."
              },
              {
                "badge": "main",
                "label": "Home makes the video",
                "command": "call_weeks, then render",
                "note": "Reads the index hourly, voices the week with Kokoro, records and renders it."
              },
              {
                "badge": "you",
                "label": "You watch it",
                "command": "Studio › Renders",
                "note": "Then share it to YouTube, save its link, and let home's copy go."
              }
            ]
          }
        }
      ]
    },
